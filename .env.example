# POS operator sign-in (till session — not pharmacy workspace APIs)
REACT_APP_POS_AUTH_URL=http://localhost:4000/api

# Outbound to pharmacy: completed sales + inventory adjustments only
REACT_APP_POS_TRANSMIT_URL=http://localhost:4000/api

# Legacy single URL (sets both auth and transmit when POS_* URLs are unset)
# REACT_APP_API_BASE_URL=http://localhost:4000/api

# Store identifier sent as X-ClarityRx-Workspace-Id on transmit requests
# REACT_APP_POS_STORE_ID=store-001
# REACT_APP_POS_STORE_NAME=ClarityRx Main Street

# Optional: show Kroll as enabled until /pos/health reports kroll.connected
# REACT_APP_POS_KROLL_ENABLED=1

# Optional: live pickup queue (pharmacy Socket.IO — off by default)
# REACT_APP_POS_PICKUP_SYNC=1
# REACT_APP_PACKAGING_SOCKET_URL=http://localhost:4000

# Optional: forward audit rows to pharmacy /audit/events (off by default)
# REACT_APP_POS_PHARMACY_AUDIT=1

# Integrated debit/credit (Securelink) — routes on transmit API
# REACT_APP_SECURELINK_ENABLED=1
# REACT_APP_SECURELINK_MOCK=1

# Self-checkout kiosk (dedicated till; set 0 to hide feature)
# REACT_APP_POS_SELF_CHECKOUT=1
# REACT_APP_POS_SELF_CHECKOUT_TILL=99
