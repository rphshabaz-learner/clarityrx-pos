# ClarityRx pharmacy API (auth + /api/pos/*)
REACT_APP_API_BASE_URL=http://localhost:4000/api

# Vercel production (clarityrx-pos is static-only — point at the main ClarityRx app API):
# REACT_APP_API_BASE_URL=https://<your-clarityrx-deployment>.vercel.app/api
# REACT_APP_PACKAGING_SOCKET_URL=https://<your-clarityrx-deployment>.vercel.app

# Realtime pickup queue (Socket.IO — same host as API without /api)
REACT_APP_PACKAGING_SOCKET_URL=http://localhost:4000

# Main pharmacy workspace URL (header link)
REACT_APP_PHARMACY_APP_URL=http://localhost:3000
