{
  "name": "clarityrx-pos",
  "version": "0.1.0",
  "private": true,
  "description": "ClarityRx point-of-sale cashier app",
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@tanstack/react-query": "^5.100.11",
    "lucide-react": "^1.16.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "socket.io-client": "^4.8.3",
    "zustand": "latest"
  },
  "scripts": {
    "prestart": "npm run build:css",
    "start": "PORT=3001 react-scripts start",
    "prebuild": "npm run build:css",
    "build": "react-scripts build",
    "build:css": "tailwindcss -i ./src/index.css -o ./src/index.build.css && node scripts/patch-tailwind-infinity.js",
    "test": "react-scripts test"
  },
  "eslintConfig": {
    "extends": ["react-app"]
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/postcss": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "postcss": "latest",
    "tailwindcss": "latest",
    "typescript": "latest"
  }
}
